# SUPABASE_* keys below are names only. Do not commit a filled copy.
# Public project configuration for Android / verification
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
# Optional current permanent user's session, never a service key
SUPABASE_USER_JWT=
# Edge Functions: built-in SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are provided by the platform when available.
# Optional newer API-key overrides, stored only in Edge secrets:
SB_PUBLISHABLE_KEY=
SB_SECRET_KEY=
ONET_API_KEY=
CARS_API_TOKEN=
