# Локально установленный PostgreSQL (без Docker).
# Команда для создания базы (через pgAdmin, подключение к БД postgres): CREATE DATABASE lastpay;
DB_URL=jdbc:postgresql://127.0.0.1:5432/lastpay
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
ADMIN_TOKEN=replace-with-at-least-32-random-characters
ADMIN_SCOPE=catalog:write
HOST=127.0.0.1
PORT=8089
DEMO_MODE=true

# Пароли ограниченных PostgreSQL-ролей создаёт scripts/init-env.ps1.
DB_READER_PASSWORD=replace-with-a-random-reader-password
DB_WRITER_PASSWORD=replace-with-a-different-random-writer-password

# Practice 10 external integrations. Leave blank to disable optional providers.
# World Bank is publicly accessible and does not need a key.
ONET_API_KEY=
CARS_API_TOKEN=
